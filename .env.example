# Create an app at https://anilist.co/settings/developer
VITE_ANILIST_CLIENT_ID=1234

# Must EXACTLY match the Redirect URL you entered when creating the app.
# Dev: http://localhost:5173/   Prod: https://your-app.vercel.app/
VITE_ANILIST_REDIRECT_URI=http://localhost:5173/

# Client secret — SERVER SIDE ONLY. Do NOT prefix with VITE_ (that would expose
# it in the browser bundle). Used by api/token.mjs (Vercel) / the Vite dev
# middleware to exchange the authorization code for an access token.
ANILIST_CLIENT_SECRET=your_client_secret
